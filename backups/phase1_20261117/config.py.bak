"""Centralised configuration. Every tunable lives here and can be set via OSIYA_* env vars or .env."""
from __future__ import annotations

from functools import lru_cache
from pathlib import Path
from typing import Literal

from pydantic import SecretStr, field_validator
from pydantic_settings import BaseSettings, SettingsConfigDict

BASE_DIR = Path(__file__).resolve().parent.parent


class Settings(BaseSettings):
    model_config = SettingsConfigDict(
        env_prefix="OSIYA_", env_file=".env", env_file_encoding="utf-8", extra="ignore"
    )

    # ---- branding / company contact (config only; never invented) ----
    company_name: str = "Osiyatech"
    assistant_name: str = "Osiya"
    company_website: str = "https://ayushitated.com/"
    contact_email: str | None = None
    contact_phone: str | None = None

    # ---- runtime ----
    app_env: str = "development"
    log_level: str = "INFO"
    log_json: bool = False
    cors_origins: str = "http://localhost:8501,http://127.0.0.1:8501"
    admin_api_key: SecretStr | None = None  # admin endpoints are disabled when unset

    # ---- request limits ----
    max_message_chars: int = 2000
    max_request_bytes: int = 64 * 1024
    rate_limit_requests: int = 30
    rate_limit_window_s: int = 60
    request_timeout_s: float = 180.0
    queue_timeout_s: float = 45.0

    # ---- LLM ----
    llm_provider: Literal["ollama", "openai_compatible"] = "ollama"
    llm_base_url: str = "http://localhost:11434"
    llm_model: str = "llama3.2:3b"
    llm_api_key: SecretStr | None = None
    llm_timeout_s: float = 120.0
    llm_max_retries: int = 1
    llm_temperature: float = 0.2
    llm_num_ctx: int = 4096
    llm_max_tokens: int = 450
    llm_voice_max_tokens: int = 220
    llm_keep_alive: str = "10m"
    llm_warmup: bool = False
    llm_concurrency: int = 1  # GTX 1650 4GB: keep generation serial
    analysis_enabled: bool = True
    analysis_max_tokens: int = 220

    # ---- knowledge base / RAG ----
    kb_dir: Path = Path("knowledge_base")
    data_dir: Path = Path("data")
    embedding_provider: Literal["auto", "sentence-transformers", "hashing"] = "auto"
    embedding_model: str = "sentence-transformers/all-MiniLM-L6-v2"
    chunk_chars: int = 900
    chunk_overlap_chars: int = 120
    retrieval_top_k: int = 4
    retrieval_candidates: int = 20
    min_confidence: float = 0.30  # below this the answer is treated as ungrounded; tune with scripts/eval_rag.py
    dense_weight: float = 0.5
    context_char_budget: int = 3200
    stale_after_days: int = 0  # 0 disables staleness warnings
    require_approved_only: bool = False  # True: only chunks explicitly marked approved are retrievable

    # ---- conversation memory ----
    session_ttl_minutes: int = 60
    max_sessions: int = 2000
    memory_recent_messages: int = 8
    memory_summary_batch: int = 6
    max_stored_turns: int = 120
    handoff_after_failures: int = 3

    # ---- leads / handoff ----
    lead_db_name: str = "leads.sqlite3"
    lead_retention_days: int = 180
    lead_offer_score: int = 40
    handoff_webhook_url: SecretStr | None = None

    # ---- speech ----
    stt_provider: Literal["faster-whisper", "none"] = "faster-whisper"
    stt_model: str = "base.en"  # small CPU-friendly default; use "base" for multilingual
    stt_device: str = "cpu"
    stt_compute_type: str = "int8"
    stt_concurrency: int = 1
    stt_timeout_s: float = 90.0
    tts_provider: Literal["piper", "none"] = "piper"
    piper_binary: str = "piper"
    piper_model_path: str | None = None
    tts_max_chars: int = 700
    tts_timeout_s: float = 60.0
    max_audio_mb: float = 10.0
    max_audio_seconds: float = 60.0
    min_audio_seconds: float = 0.4
    low_transcript_confidence: float = 0.45

    @field_validator("kb_dir", "data_dir", mode="after")
    @classmethod
    def _resolve(cls, v: Path) -> Path:
        return v if v.is_absolute() else (BASE_DIR / v)

    @property
    def index_dir(self) -> Path:
        return self.data_dir / "index"

    @property
    def lead_db_path(self) -> Path:
        return self.data_dir / self.lead_db_name

    @property
    def cors_origin_list(self) -> list[str]:
        return [o.strip() for o in self.cors_origins.split(",") if o.strip()]

    @property
    def max_audio_bytes(self) -> int:
        return int(self.max_audio_mb * 1024 * 1024)


@lru_cache
def get_settings() -> Settings:
    return Settings()
