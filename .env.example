# Copy to .env and edit. Never commit .env. All variables use the OSIYA_ prefix.

# --- Branding / contact (shown to visitors; leave unset if you don't have one) ---
OSIYA_COMPANY_NAME=Osiyatech
OSIYA_ASSISTANT_NAME=Osiya
OSIYA_COMPANY_WEBSITE=https://ayushitated.com/
# OSIYA_CONTACT_EMAIL=
# OSIYA_CONTACT_PHONE=

# --- Runtime / security ---
OSIYA_APP_ENV=development
OSIYA_LOG_LEVEL=INFO
OSIYA_LOG_JSON=false
OSIYA_CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
# Required to use /api/v1/knowledge/* and GET /api/v1/leads. Admin endpoints are disabled when unset.
# OSIYA_ADMIN_API_KEY=change-me-to-a-long-random-string

# --- LLM (Ollama by default) ---
OSIYA_LLM_PROVIDER=ollama
OSIYA_LLM_BASE_URL=http://localhost:11434
OSIYA_LLM_MODEL=llama3.2:3b
OSIYA_LLM_TIMEOUT_S=120
OSIYA_LLM_CONCURRENCY=1
OSIYA_LLM_WARMUP=false
# For provider=openai_compatible (LM Studio, llama.cpp server, a cloud API):
# OSIYA_LLM_API_KEY=

# --- Knowledge base ---
OSIYA_KB_DIR=knowledge_base
OSIYA_EMBEDDING_PROVIDER=auto
OSIYA_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
OSIYA_MIN_CONFIDENCE=0.30

# --- Leads / handoff ---
OSIYA_LEAD_RETENTION_DAYS=180
# Optional: POSTs a JSON summary when a visitor asks for human follow-up.
# OSIYA_HANDOFF_WEBHOOK_URL=

# --- Speech (optional) ---
OSIYA_STT_PROVIDER=faster-whisper
OSIYA_STT_MODEL=base.en
OSIYA_TTS_PROVIDER=piper
# OSIYA_PIPER_BINARY=C:\tools\piper\piper.exe
# OSIYA_PIPER_MODEL_PATH=C:\tools\piper\en_US-lessac-medium.onnx

# --- Frontend ---
OSIYA_BACKEND_URL=http://localhost:8000
